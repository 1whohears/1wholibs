{
  "schemaVersion": 1,
  "id": "onewholibs",
  "version": "${version}",
  "name": "1wholibs",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${homepage}",
    "sources": "${issue_tracker}"
  },
  "license": "MIT",
  "icon": "assets/onewholibs/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.onewhohears.onewholibs.fabric.OWLModFabric"
    ],
    "client": [
      "com.onewhohears.onewholibs.fabric.client.OWLModFabricClient"
    ]
  },
  "mixins": [
    "onewholibs.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "architectury": ">=${architectury_version}"
  },
  "suggests": {
    "ftbteams": ">=${ftb_teams_version}",
    "ftblibrary": ">=${ftb_library_version}",
    "openpartiesandclaims": ">=${openpartiesandclaims_version}",
    "forgeconfigapiport_version": ">=${forgeconfigapiport_version}"
  }
}
